<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    
    <!-- Console Appender com formato JSON -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp/>
                <logLevel/>
                <loggerName/>
                <message/>
                <mdc/>
                <pattern>
                    <pattern>
                        {
                        "dd.trace_id": "%X{dd.trace_id:-}",
                        "dd.span_id": "%X{dd.span_id:-}",
                        "dd.service": "${DD_SERVICE:-datadog-logging-example}",
                        "dd.env": "${DD_ENV:-development}",
                        "dd.version": "${DD_VERSION:-1.0.0}"
                        }
                    </pattern>
                </pattern>
                <arguments/>
                <stackTrace/>
            </providers>
        </encoder>
    </appender>
    
    <!-- File Appender com JSON para Datadog -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/application.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/application.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp/>
                <logLevel/>
                <loggerName/>
                <message/>
                <mdc/>
                <pattern>
                    <pattern>
                        {
                        "dd.trace_id": "%X{dd.trace_id:-}",
                        "dd.span_id": "%X{dd.span_id:-}",
                        "dd.service": "${DD_SERVICE:-datadog-logging-example}",
                        "dd.env": "${DD_ENV:-development}",
                        "dd.version": "${DD_VERSION:-1.0.0}",
                        "source": "java",
                        "host": "${HOSTNAME:-localhost}"
                        }
                    </pattern>
                </pattern>
                <arguments/>
                <stackTrace/>
            </providers>
        </encoder>
    </appender>
    
    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
    
    <!-- Logger específico para sua aplicação -->
    <logger name="com.example" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </logger>
    
</configuration>